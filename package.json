{
  "name": "curacao-crypto-onramp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Root tooling for the KambioX on-ramp monorepo (pnpm + turbo)",
  "scripts": {
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "compile": "turbo run compile",
    "start:backend": "turbo run start --filter=@kambiox/backend",
    "start:bot": "turbo run start --filter=@kambiox/bot",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "turbo": "2.11.10"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.8"
  }
}
