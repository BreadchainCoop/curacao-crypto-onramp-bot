{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^test:coverage"
      ]
    },
    "compile": {
      "outputs": [
        "artifacts/**",
        "cache/**"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
