# @kambiox/contracts-evm — copy to contracts/evm/.env (never commit .env).
# Read by hardhat.config.js and the deploy / transfer-ownership scripts.

# Deployer / current escrow owner key. Testnet only; mainnet owners are MPC
# wallets (see ../../MAINNET.md). NEVER COMMIT THIS.
ADMIN_WALLET_PRIVATE_KEY=your_admin_wallet_private_key_here_NEVER_COMMIT_THIS

# Per-network RPC overrides (each network has a public default in hardhat.config.js):
# BASE_SEPOLIA_RPC_URL=
# POLYGON_AMOY_RPC_URL=
# CELO_SEPOLIA_RPC_URL=
# ARC_TESTNET_RPC_URL=
# BASE_RPC_URL=
# POLYGON_RPC_URL=
# CELO_RPC_URL=
# ARC_RPC_URL=

# Explorer API keys — used only for `hardhat verify` after deploy (Sourcify is
# the keyless fallback).
BASESCAN_API_KEY=your_basescan_api_key_here
# POLYGONSCAN_API_KEY=
# CELOSCAN_API_KEY=

# USDC the escrow binds to. The deploy:* scripts set this per network, or set
# USE_MOCK_USDC=1 to deploy MockUSDC on a testnet.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
