{
  "name": "curacao-onramp-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Solidity escrow contract for the Curaçao crypto on-ramp (Hardhat)",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:amoy": "USE_MOCK_USDC=1 hardhat run scripts/deploy.js --network polygon-amoy",
    "deploy:base-sepolia": "USE_MOCK_USDC=1 hardhat run scripts/deploy.js --network base-sepolia",
    "deploy:celo-sepolia": "USE_MOCK_USDC=1 hardhat run scripts/deploy.js --network celo-sepolia",
    "deploy:arc-testnet": "USE_MOCK_USDC=1 hardhat run scripts/deploy.js --network arc-testnet",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:celo": "hardhat run scripts/deploy.js --network celo"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
