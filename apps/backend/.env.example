# @kambiox/backend — copy to apps/backend/.env (never commit .env).
# On Render these are set in the dashboard (render.yaml lists the keys).

# ─── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: used by /return to bounce the browser back into the chat.
# TELEGRAM_BOT_USERNAME=your_bot
# TELEGRAM_RETURN_URL=

# ─── Sentoo (use sandbox values for MVP) ────────────────
# API secret — sent as the X-SENTOO-SECRET header on Sentoo API calls.
SENTOO_API_KEY=your_sentoo_api_key_here
SENTOO_MERCHANT_ID=your_sentoo_merchant_id_here
# Optional shared token appended to YOUR webhook URL (?token=…) as a basic auth
# layer. NOTE: Sentoo's webhook is a ping (transaction_id only); payment is
# confirmed by re-fetching status from the API — this is NOT a Sentoo HMAC.
SENTOO_WEBHOOK_SECRET=your_optional_webhook_url_token_here
# Sentoo API host — no trailing /v1 (the client appends /v1/payment/...).
# Sandbox: https://api.sandbox.sentoo.io   Production: https://api.sentoo.io
SENTOO_BASE_URL=https://api.sandbox.sentoo.io
# Browser redirect URL after payment (e.g. a deep link back to the bot).
SENTOO_RETURN_URL=https://t.me/your_bot

# ─── Privy — OPERATOR app (escrow release signer) ───────
# A SEPARATE Privy app from the bot's users app. The escrow signing key is
# sharded in Privy's MPC/TEE and never lives on this host — we only hold request
# credentials. Used when ESCROW_SIGNER=privy. Never set these on the bot host.
PRIVY_OPERATOR_APP_ID=your_privy_operator_app_id_here
PRIVY_OPERATOR_APP_SECRET=your_privy_operator_app_secret_here
# P-256 authorization private key that lets this backend authorize wallet ops.
PRIVY_OPERATOR_AUTHORIZATION_KEY=your_privy_operator_authorization_key_here
# The operator server wallet's id (its public address goes on-chain as the escrow
# owner/releaser via ESCROW_OPERATOR_ADDRESS).
PRIVY_OPERATOR_WALLET_ID=your_privy_operator_wallet_id_here

# ─── Circle Programmable Wallets (escrow signer, ESCROW_SIGNER=circle) ───
# Circle-native MPC/HSM custody; supports Arc + Base. Backend host only.
# Create the wallet with scripts/setup-circle-wallet.js. Optional tuning:
# CIRCLE_BLOCKCHAIN, CIRCLE_WALLET_SET_NAME, CIRCLE_FEE_LEVEL.
CIRCLE_API_KEY=your_circle_production_api_key_here
# 32-byte entity secret (ciphertext registered once with Circle; never stored by Circle).
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here
# The developer-controlled operator wallet id (its EOA address owns the escrow).
CIRCLE_WALLET_ID=your_circle_wallet_id_here

# ─── Synaps KYC ─────────────────────────────────────────
# Sent as the Api-Key header on Synaps API calls.
SYNAPS_API_KEY=your_synaps_api_key_here
# Webhook auth — compared to the ?secret= query param Synaps appends to the
# webhook URL configured in your Synaps manager.
SYNAPS_WEBHOOK_SECRET=your_synaps_webhook_secret_here
# Synaps individual API base (no trailing /session/init).
# TODO(#8): confirm the exact host (incl. sandbox) in the Synaps docs.
SYNAPS_BASE_URL=https://individual-api.synaps.io/v3
# Hosted verification page base — the link sent to the user.
SYNAPS_VERIFY_URL=https://verify.synaps.io/

# ─── Chain / escrow (see packages/chains) ────────────────
# Active chain key (polygon-amoy, base-sepolia, celo-sepolia, arc-testnet,
# arc-mainnet, base-mainnet). Per-chain overrides: <KEY>_RPC_URL,
# <KEY>_ESCROW_ADDRESS, <KEY>_USDC_ADDRESS (e.g. BASE_SEPOLIA_RPC_URL).
CHAIN=base-sepolia
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# USDC token the escrow holds. Defaults to Circle's Base Sepolia USDC if unset.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Escrow release signer selector:
#   circle -> Circle Programmable Wallets (MPC/HSM; host holds no key; Arc + Base)
#   privy  -> Privy operator server wallet (MPC; host holds no key)
#   raw    -> ethers Wallet holding ADMIN_WALLET_PRIVATE_KEY (legacy fallback)
#   fake   -> no chain; CI/local only
# Unset defaults to `raw` if ADMIN_WALLET_PRIVATE_KEY is present, else `privy`.
ESCROW_SIGNER=raw
# Only for ESCROW_SIGNER=raw. Testnet only; mainnet uses an MPC signer.
ADMIN_WALLET_PRIVATE_KEY=your_admin_wallet_private_key_here_NEVER_COMMIT_THIS
# Base URL for the tx receipt link sent to users (chain-specific).
EXPLORER_TX_BASE_URL=https://sepolia.basescan.org/tx/

# ─── Operator API (bot admin → backend, #18) ────────────
# The bot has no chain key; admin balance/refund call this API, which signs.
# The bot must hold the same OPS_API_SECRET. Use a long random value.
OPS_API_SECRET=your_ops_api_shared_secret_here

# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Webhook rate limiting ──────────────────────────────
# Max webhook requests per IP per window, and the window length (ms).
WEBHOOK_RATE_MAX=120
WEBHOOK_RATE_WINDOW_MS=60000

# ─── Orders ─────────────────────────────────────────────
# Minutes before an unpaid order is expired by the sweeper.
ORDER_TTL_MINUTES=30
# How often (ms) the expiry sweeper runs.
EXPIRY_SWEEP_MS=60000

# ─── Server ─────────────────────────────────────────────
# PORT=3000
