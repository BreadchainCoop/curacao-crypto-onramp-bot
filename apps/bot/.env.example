# @kambiox/bot — copy to apps/bot/.env (never commit .env).
# The bot holds NO chain key. On Render these are set in the dashboard.

# ─── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_telegram_user_id_here

# ─── Sentoo (use sandbox values for MVP) ────────────────
# API secret — sent as the X-SENTOO-SECRET header on Sentoo API calls.
SENTOO_API_KEY=your_sentoo_api_key_here
SENTOO_MERCHANT_ID=your_sentoo_merchant_id_here
# Sentoo API host — no trailing /v1 (the client appends /v1/payment/...).
# Sandbox: https://api.sandbox.sentoo.io   Production: https://api.sentoo.io
SENTOO_BASE_URL=https://api.sandbox.sentoo.io
# Browser redirect URL after payment (e.g. a deep link back to the bot).
SENTOO_RETURN_URL=https://t.me/your_bot
# Optional processing-fee display: SENTOO_FEE_ENABLED, SENTOO_FEE_PCT,
# SENTOO_FEE_CAP_USD, SENTOO_INTERBANK_PCT.

# ─── Privy — USERS app (buyer wallets only) ─────────────
# This app ONLY creates buyer destination wallets. It must NOT be the operator
# app, and its secret must never let anyone move escrow funds.
PRIVY_APP_ID=your_privy_users_app_id_here
PRIVY_APP_SECRET=your_privy_users_app_secret_here

# ─── Operator API (bot admin → backend, #18) ────────────
# Admin balance/refund call the backend, which signs. OPS_API_URL is the backend
# base URL; OPS_API_SECRET must match the backend's.
OPS_API_URL=https://your-app.onrender.com
OPS_API_SECRET=your_ops_api_shared_secret_here

# ─── Chain / escrow (see packages/chains) ────────────────
# Active chain key; per-chain overrides as in the backend (<KEY>_RPC_URL, …).
CHAIN=base-sepolia
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Liquidity pre-check buffer kept in the escrow (USDC); optional BUY_MIN_USDC /
# BUY_MAX_USDC order limits.
ESCROW_RESERVE_BUFFER_USDC=0

# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Feature flags ──────────────────────────────────────
# Set to "false" to skip the KYC gate on /buy (e.g. while Synaps is parked for
# the MVP). Any other value (or unset) keeps KYC required.
KYC_REQUIRED=true

# ─── FX / pricing ───────────────────────────────────────
# XCG (Caribbean guilder) per 1 USDC. Sourced from the CBCS "Official Exchange
# Rates for Use by the Commercial Banks". The user buys USD (USDC), so the USD
# "Sell" rate applies: 1.82. Central parity is 1.79; NOT 1:1. See lib/cbcsRates.js.
FX_PEG_RATE=1.82
# FX spread (margin baked into the rate), percent.
FX_SPREAD_PCT=1.5
# Platform fee switch — when true, captures a small fee into the exchange.
FX_FEE_ENABLED=true
# Platform fee, percent of order value (USDC notional).
FX_FEE_PCT=1.0
# Minimum fee in XCG, so tiny orders still cover fixed costs. Optional cap: FX_FEE_MAX_XCG.
FX_FEE_FLAT_MIN_XCG=0.50
