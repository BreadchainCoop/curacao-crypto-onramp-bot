# ─── Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Sentoo (use sandbox values for MVP) ────────────────
# API secret — sent as the X-SENTOO-SECRET header on Sentoo API calls.
SENTOO_API_KEY=your_sentoo_api_key_here
SENTOO_MERCHANT_ID=your_sentoo_merchant_id_here
# Optional shared token appended to YOUR webhook URL (?token=…) as a basic auth
# layer. NOTE: Sentoo's webhook is a ping (transaction_id only); payment is
# confirmed by re-fetching status from the API — this is NOT a Sentoo HMAC.
SENTOO_WEBHOOK_SECRET=your_optional_webhook_url_token_here
# Sentoo API host — no trailing /v1 (the client appends /v1/payment/...).
# Sandbox: https://api.sandbox.sentoo.io   Production: https://api.sentoo.io
SENTOO_BASE_URL=https://api.sandbox.sentoo.io
# Browser redirect URL after payment (e.g. a deep link back to the bot).
SENTOO_RETURN_URL=https://t.me/your_bot

# ─── Privy — USERS app (bot: buyer wallets only) ────────
# This app ONLY creates buyer destination wallets. It must NOT be the operator
# app, and its secret must never let anyone move escrow funds.
PRIVY_APP_ID=your_privy_users_app_id_here
PRIVY_APP_SECRET=your_privy_users_app_secret_here

# ─── Privy — OPERATOR app (backend: escrow release signer) ──
# A SEPARATE Privy app. The escrow signing key is sharded in Privy's MPC/TEE and
# never lives on this host — we only hold request credentials below. These belong
# on the BACKEND host only (never on the bot). Used when ESCROW_SIGNER=privy.
PRIVY_OPERATOR_APP_ID=your_privy_operator_app_id_here
PRIVY_OPERATOR_APP_SECRET=your_privy_operator_app_secret_here
# P-256 authorization private key that lets this backend authorize wallet ops.
PRIVY_OPERATOR_AUTHORIZATION_KEY=your_privy_operator_authorization_key_here
# The operator server wallet's id (its public address goes on-chain as the escrow
# owner/releaser via ESCROW_OPERATOR_ADDRESS — see contracts/.env).
PRIVY_OPERATOR_WALLET_ID=your_privy_operator_wallet_id_here

# ─── Synaps KYC ─────────────────────────────────────────
# Sent as the Api-Key header on Synaps API calls.
SYNAPS_API_KEY=your_synaps_api_key_here
# Webhook auth — compared to the ?secret= query param Synaps appends to the
# webhook URL configured in your Synaps manager.
SYNAPS_WEBHOOK_SECRET=your_synaps_webhook_secret_here
# Synaps individual API base (no trailing /session/init).
# TODO(#8): confirm the exact host (incl. sandbox) in the Synaps docs.
SYNAPS_BASE_URL=https://individual-api.synaps.io/v3
# Hosted verification page base — the link sent to the user.
SYNAPS_VERIFY_URL=https://verify.synaps.io/

# ─── Blockchain / RPC ───────────────────────────────────
ALCHEMY_API_KEY=your_alchemy_api_key_here
RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# ─── Smart contract ─────────────────────────────────────
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Escrow release signer selector:
#   privy -> Privy operator server wallet (MPC; host holds no key)  ← target
#   raw   -> ethers Wallet holding ADMIN_WALLET_PRIVATE_KEY (legacy fallback)
#   fake  -> no chain; CI/local only
# Unset defaults to `raw` if ADMIN_WALLET_PRIVATE_KEY is present, else `privy`.
ESCROW_SIGNER=raw
# Only for ESCROW_SIGNER=raw (backend) and the contracts deploy/transfer scripts.
# The BOT no longer uses this key (#18) — do not set it on the bot host.
ADMIN_WALLET_PRIVATE_KEY=your_admin_wallet_private_key_here_NEVER_COMMIT_THIS

# ─── Operator API (bot admin → backend, #18) ────────────
# The bot has no chain key; admin balance/refund call the backend, which signs.
# Backend: set OPS_API_SECRET. Bot: set OPS_API_URL (backend base URL) + the
# same OPS_API_SECRET. Use a long random value.
OPS_API_SECRET=your_ops_api_shared_secret_here
OPS_API_URL=https://your-app.onrender.com
# USDC token the escrow holds. Defaults to Circle's Base Sepolia USDC if unset.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Basescan API key — used only for `hardhat verify` after deploy.
BASESCAN_API_KEY=your_basescan_api_key_here

# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Feature flags ──────────────────────────────────────
# Set to "false" to skip the KYC gate on /buy (e.g. while Synaps is parked for
# the MVP). Any other value (or unset) keeps KYC required.
KYC_REQUIRED=true

# ─── FX / pricing ───────────────────────────────────────
# XCG (Caribbean guilder) per 1 USDC. Sourced from the CBCS "Official Exchange
# Rates for Use by the Commercial Banks". The user buys USD (USDC), so the USD
# "Sell" rate applies: 1.82. Central parity is 1.79; NOT 1:1. See bot/lib/cbcsRates.js.
FX_PEG_RATE=1.82
# FX spread (margin baked into the rate), percent.
FX_SPREAD_PCT=1.5
# Platform fee switch — when true, captures a small fee into the exchange.
FX_FEE_ENABLED=true
# Platform fee, percent of order value (USDC notional).
FX_FEE_PCT=1.0
# Minimum fee in XCG, so tiny orders still cover fixed costs.
FX_FEE_FLAT_MIN_XCG=0.50

# ─── Block explorer ─────────────────────────────────────
# Base URL for the tx receipt link sent to users (chain-specific). Amoy default.
EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

# ─── Webhook rate limiting ──────────────────────────────
# Max webhook requests per IP per window, and the window length (ms).
WEBHOOK_RATE_MAX=120
WEBHOOK_RATE_WINDOW_MS=60000

# ─── Orders ─────────────────────────────────────────────
# Minutes before an unpaid order is expired by the sweeper.
ORDER_TTL_MINUTES=30
# How often (ms) the expiry sweeper runs.
EXPIRY_SWEEP_MS=60000

# ─── Admin ──────────────────────────────────────────────
ADMIN_TELEGRAM_ID=your_telegram_user_id_here
